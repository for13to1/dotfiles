# ============================================================
# macOS 新机必装（Homebrew）
# 其余的参考 Brewfile 按需手动安装
# 按依赖顺序与场景分组；formula 与 cask 分区
# ============================================================

# ---------- Formula（命令行工具） ----------

# ---- 构建基础 ----
brew "xcodegen"
brew "cmake"
brew "cloc"

# ---- 版本控制与密钥 ----
brew "git"
brew "gh"
brew "git-crypt"
brew "git-lfs"
brew "gnupg"

# ---- 容器与服务 ----
brew "colima", restart_service: :changed
brew "docker"
brew "docker-buildx"
brew "docker-compose"
brew "redis", restart_service: :changed

# ---- 运行时与语言 ----
brew "fnm"
brew "rustup"
brew "uv"

# ---- Shell 与终端 ----
brew "stow"
brew "tmux"
brew "tpm"
brew "tree"
brew "bat"
brew "eza"
brew "fd"
brew "ripgrep"
brew "fzf"
brew "jq"
brew "zoxide"
brew "rename"
brew "shellcheck"
brew "shfmt"

# ---- 编辑器 ----
brew "neovim"

# ---- 开发工具 ----
brew "scrcpy"

# ---- AI 工具 ----
brew "llama.cpp"
brew "pi-coding-agent"
brew "opencode"

# ---- 网络与下载 ----
brew "aria2"
brew "wget"

# ---- 媒体 ----
brew "ffmpeg"

# ---------- Cask（GUI 应用） ----------

# ---- 浏览器 ----
cask "google-chrome"

# ---- 终端 ----
cask "iterm2"

# ---- 编辑器 ----
cask "visual-studio-code"
cask "zed"
cask "mweb-pro"

# ---- 开发工具 ----
cask "android-platform-tools"
cask "beyond-compare"
cask "drawio"

# ---- AI 工具 ----
cask "opencode-desktop"

# ---- 文档 ----
cask "pdf-expert"

# ---- 媒体 ----
cask "iina"

# ---- 系统工具 ----
cask "aldente"
cask "betterdisplay"
cask "jordanbaird-ice"
cask "keka"
cask "maccy"
cask "popclip"
cask "stats"

# ---- 字体 ----
cask "font-hack-nerd-font"
cask "font-meslo-for-powerlevel10k"
