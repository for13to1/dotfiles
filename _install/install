#!/usr/bin/env bash
#
# _install/install — 按组安装软件包
#
# 未指定时安装 default 组。
#
# 用法:
#   install --<platform> [group...]
#     --<platform>  --apt | --pacman | --brew
#     [group...]  组名，可多选；缺省时安装 default 组
#
# 环境变量:
#   INSTALL_DRY=1       只输出合并去重后的最终列表，不真正安装（供测试/预览）
#   INSTALL_BASE_DIR=…  覆盖 .group 文件根目录（默认脚本所在目录，测试用）
#
# 约定:
#   - 每组一个 .group 文件：apt/pacman 每行一个包名，brew 为 brew/cask 行。
#   - 组间允许重复包：合并后按包名去重，再一次性安装。
#

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="${SCRIPT_DIR}/${SCRIPT_PATH}"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../_scripts/common.sh"

# 进度/警告日志走 stderr，最终列表（DRY 输出）独占 stdout，便于管道与测试断言。
info()      { msg 'info'  "$*" >&2; }
warn()      { msg 'warn'  "$*" >&2; }
ok()        { msg 'ok'    "$*" >&2; }
error_msg() { msg 'error' "$*" >&2; }

if (( $# < 1 )); then
    echo "用法: $0 --<platform> [group...]" >&2
    echo "      --<platform>  --apt | --pacman | --brew" >&2
    echo "      [group...]  组名，可多选；缺省时安装 default 组" >&2
    exit 2
fi

PLATFORM_FLAG="$1"
shift

case "$PLATFORM_FLAG" in
    --apt)    PLATFORM="apt";    ext="group" ;;
    --pacman) PLATFORM="pacman"; ext="group" ;;
    --brew)   PLATFORM="brew";   ext="group" ;;
    *) error "不支持的平台: $PLATFORM_FLAG (可选: --apt | --pacman | --brew)" ;;
esac

BASE_DIR="${INSTALL_BASE_DIR:-$SCRIPT_DIR}"

# ── 确定组集合（缺省 = default 组）───────────────────────────────
groups=()
if (( $# == 0 )); then
    groups=(default)
    info "未指定组，安装 $PLATFORM 默认组: ${groups[*]}"
else
    groups=("$@")
fi

# ── 收集 .group 文件 → 合并去重 ─────────────────────────────────
declare -a all_lines=()
for group in "${groups[@]}"; do
    file="$BASE_DIR/$PLATFORM/$group.$ext"
    if [[ ! -f "$file" ]]; then
        warn ".group 文件不存在: ${file}，跳过"
        continue
    fi
    info "收集组 [$PLATFORM/$group]: $file"
    while IFS= read -r line; do
        all_lines+=("$line")
    done < <(group_list_lines "$file")
done

if (( ${#all_lines[@]} == 0 )); then
    warn "没有可安装的包，跳过安装"
    exit 0
fi

if [[ "$PLATFORM" == "brew" ]]; then
    merged="$(printf '%s\n' "${all_lines[@]}" | dedupe_brewfile)"
else
    merged="$(printf '%s\n' "${all_lines[@]}" | dedupe_lines)"
fi

if [[ -z "$merged" ]]; then
    warn "没有可安装的包，跳过安装"
    exit 0
fi

# ── 干跑：只输出合并去重后的最终列表 ─────────────────────────────
if [[ -n "${INSTALL_DRY:-}" ]]; then
    printf '%s\n' "$merged"
    exit 0
fi

# ── 一次性安装 ───────────────────────────────────────────────────
pkgs=()
while IFS= read -r p; do
    [[ -n "$p" ]] && pkgs+=("$p")
done <<< "$merged"

case "$PLATFORM" in
    apt)
        command -v apt &>/dev/null || error "未找到 apt"
        info "正在通过 apt 安装 ${#pkgs[@]} 个软件包..."
        if ! sudo apt install -y "${pkgs[@]}"; then
            warn "apt 安装有失败项，请稍后重试"
            exit 1
        fi
        ;;
    pacman)
        command -v pacman &>/dev/null || error "未找到 pacman"
        info "正在通过 pacman 安装 ${#pkgs[@]} 个软件包..."
        if ! sudo pacman -S --noconfirm --needed "${pkgs[@]}"; then
            warn "pacman 安装有失败项，请稍后重试"
            exit 1
        fi
        ;;
    brew)
        command -v brew &>/dev/null || error "未找到 brew"
        tmp="$(mktemp "${TMPDIR:-/tmp}/install-brew.XXXXXX")"
        trap 'rm -f "$tmp"' EXIT
        printf '%s\n' "$merged" > "$tmp"
        info "正在通过 brew bundle 安装（${#pkgs[@]} 项）..."
        if ! brew bundle --file="$tmp"; then
            warn "brew 安装有失败项，请稍后重试"
            exit 1
        fi
        ;;
esac

ok "$PLATFORM 组安装完成: ${groups[*]}"
