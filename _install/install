#!/usr/bin/env bash
#
# _install/install — install packages by group
#
# Installs the "default" group when none is specified.
#
# Usage:
#   install --<platform> [group...]
#     --<platform>  --apt | --pacman | --brew
#     [group...]    group names, can be multiple; defaults to the "default" group
#
# Environment:
#   INSTALL_DRY=1       print the merged, deduped final list without installing (test/preview)
#   INSTALL_BASE_DIR=…  override the .group root (defaults to the script dir; for tests)
#
# Conventions:
#   - One .group file per group: apt/pacman have one package per line; brew has brew/cask lines.
#   - Duplicate packages across groups are allowed: merged, deduped, then installed once.
#

set -euo pipefail

SCRIPT_DIR="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/../_scripts/common.sh"

# Progress/warning logs go to stderr; the final list (DRY output) owns stdout so it
# can be piped and asserted in tests.
info()      { msg 'info'  "$*" >&2; }
warn()      { msg 'warn'  "$*" >&2; }
ok()        { msg 'ok'    "$*" >&2; }
error_msg() { msg 'error' "$*" >&2; }

if (( $# < 1 )); then
    echo "Usage: $0 --<platform> [group...]" >&2
    echo "      --<platform>  --apt | --pacman | --brew" >&2
    echo "      [group...]    group names, can be multiple; defaults to the 'default' group" >&2
    exit 2
fi

PLATFORM_FLAG="$1"
shift

case "$PLATFORM_FLAG" in
    --apt)    PLATFORM="apt";    ext="group" ;;
    --pacman) PLATFORM="pacman"; ext="group" ;;
    --brew)   PLATFORM="brew";   ext="group" ;;
    *) error "Unsupported platform: $PLATFORM_FLAG (choices: --apt | --pacman | --brew)" ;;
esac

BASE_DIR="${INSTALL_BASE_DIR:-$SCRIPT_DIR}"

# ── Resolve the group set (default = "default" group) ──────────────
groups=()
if (( $# == 0 )); then
    groups=(default)
    info "No group specified; installing the $PLATFORM default group: ${groups[*]}"
else
    groups=("$@")
fi

# ── Collect .group files → merge & dedupe ──────────────────────────
declare -a all_lines=()
missing_groups=()
for group in "${groups[@]}"; do
    file="$BASE_DIR/$PLATFORM/$group.$ext"
    if [[ ! -f "$file" ]]; then
        missing_groups+=("$group")
        continue
    fi
    info "Collecting group [$PLATFORM/$group]: $file"
    while IFS= read -r line; do
        all_lines+=("$line")
    done < <(group_list_lines "$file")
done

if (( ${#missing_groups[@]} > 0 )); then
    error "Unknown $PLATFORM install group: ${missing_groups[*]}"
fi

if (( ${#all_lines[@]} == 0 )); then
    warn "No packages to install; skipping"
    exit 0
fi

if [[ "$PLATFORM" == "brew" ]]; then
    merged="$(printf '%s\n' "${all_lines[@]}" | dedupe_brewfile)"
else
    merged="$(printf '%s\n' "${all_lines[@]}" | dedupe_lines)"
fi

if [[ -z "$merged" ]]; then
    warn "No packages to install; skipping"
    exit 0
fi

# ── Dry run: print only the merged, deduped final list ─────────────
if [[ -n "${INSTALL_DRY:-}" ]]; then
    printf '%s\n' "$merged"
    exit 0
fi

# ── One-shot install ───────────────────────────────────────────────
pkgs=()
while IFS= read -r p; do
    [[ -n "$p" ]] && pkgs+=("$p")
done <<< "$merged"

case "$PLATFORM" in
    apt)
        command -v apt &>/dev/null || error "apt not found"
        info "Installing ${#pkgs[@]} packages via apt..."
        if ! sudo apt install -y "${pkgs[@]}"; then
            warn "apt install had failures; retry later"
            exit 1
        fi
        ;;
    pacman)
        command -v pacman &>/dev/null || error "pacman not found"
        info "Installing ${#pkgs[@]} packages via pacman..."
        if ! sudo pacman -S --noconfirm --needed "${pkgs[@]}"; then
            warn "pacman install had failures; retry later"
            exit 1
        fi
        ;;
    brew)
        command -v brew &>/dev/null || error "brew not found"
        tmp="$(mktemp "${TMPDIR:-/tmp}/install-brew.XXXXXX")"
        trap 'rm -f "$tmp"' EXIT
        printf '%s\n' "$merged" > "$tmp"
        info "Installing via brew bundle (${#pkgs[@]} entries)..."
        if ! brew bundle --file="$tmp"; then
            warn "brew install had failures; retry later"
            exit 1
        fi
        ;;
esac

ok "$PLATFORM group install complete: ${groups[*]}"
