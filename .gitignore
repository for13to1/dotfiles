# 本地私有配置（不入库）
*.local

# macOS
**/.DS_Store

# 编辑器临时文件
*.swp
*.swo
*~
**/*.bak

# 日志与临时状态
*.log
.check_failed

# 第三方安装器原始脚本（仅本地参考，不入库）
_install/installer/

# Python 缓存
__pycache__/
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Neovim 插件锁文件（每台机器各自生成，不入库）
nvim/.config/nvim/lazy-lock.json

# CodeGraph 每项目索引（本地生成，不入库）
.codegraph/
